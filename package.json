{
  "name": "miniprogram-cookie-shim",
  "version": "0.0.1",
  "license": "MIT",
  "author": "Xingzeng Bao",
  "homepage": "https://github.com/baoxingzeng/miniprogram-cookie-shim",
  "description": "document.cookie-like cookie shim for mini programs. Plugin for miniprogram-xmlhttprequest-shim.",
  "type": "module",
  "main": "dist/miniprogram-cookie-shim.cjs.js",
  "module": "dist/miniprogram-cookie-shim.esm.js",
  "types": "dist/index.d.ts",
  "files": [
    "README.md",
    "dist",
    "!dist/types/**/*",
    "!dist/cjs/types/**/*",
    "!dist/esm/types/**/*"
  ],
  "exports": {
    ".": {
      "require": "./dist/cjs/index.js",
      "import": "./dist/esm/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "rollup --config",
    "test": "echo \"Tests are integrated in miniprogram-xmlhttprequest-shim.\" && exit 0"
  },
  "keywords": [
    "miniprogram",
    "cookie"
  ],
  "dependencies": {
    "miniprogram-platform": ">=1.1.0",
    "set-cookie-parser": "^3.1.2",
    "url-parse": "^1.5.10",
    "valid-url": "^1.0.9"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@rollup/plugin-babel": "^7.1.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/url-parse": "^1.4.11",
    "@types/valid-url": "^1.0.7",
    "rollup": "^4.62.3",
    "rollup-plugin-dts": "^6.4.1",
    "tslib": "^2.8.1"
  }
}
